</section>
<script>
    function initOrderLoadMore() {
        return {
            loading: false,
            linkClasses() {
                return {'opacity-60 pointer-events-none': this.loading};
            },
            async loadMore() {
                this.$event.preventDefault();
                const link = this.$event.currentTarget;
                const endpoint = link.dataset.endpoint;
                if (!endpoint) {
                    window.location.assign(link.href);
                    return;
                }
                this.loading = true;
                try {
                    const response = await fetch(endpoint, {headers: {'X-Requested-With': 'XMLHttpRequest'}});
                    const data = await response.json();
                    if (this.$refs.list && typeof data.html === 'string' && data.html !== '') {
                        this.$refs.list.innerHTML = data.html;
                    }
                    if (data.hasMore) {
                        link.href = data.nextHref || link.href;
                        link.dataset.endpoint = data.nextEndpoint || '';
                        this.loading = false;
                    } else if (this.$refs.wrap) {
                        this.$refs.wrap.remove();
                    }
                } catch (error) {
                    window.location.assign(link.href);
                }
            }
        }
    }
    window.addEventListener('alpine:init', () => Alpine.data('initOrderLoadMore', initOrderLoadMore), {once: true})
</script>
<?php isset($hyvaCsp) && $hyvaCsp->registerInlineScript() ?>
