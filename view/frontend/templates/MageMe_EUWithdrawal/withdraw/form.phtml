                                                </div>
                                            </td></tr>
                                        </template>

                                        <!-- Per-item reason -->
                                        <?php if ($reasonsEnabled): ?>
                                            <template x-if="row.eligible && qtyOf(row.id) > 0">
                                                <tr class="max-sm:block max-sm:mb-3"><td colspan="7" class="pb-3 max-sm:block max-sm:p-0">
