                                                    <label class="mb-2 flex cursor-pointer items-start gap-2.5 rounded border border-gray-200 border-l-[3px] border-l-emerald-500 bg-white px-3.5 py-3 transition-colors has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-50">
                                                        <input type="radio" :name="'seal_' + row.id" :checked="sealOf(row.id) === false" @change="setSeal(row, false)" class="mt-0.5 h-[18px] w-[18px] shrink-0 accent-emerald-600">
                                                        <span class="flex-1">
                                                            <span class="block text-[14px] font-semibold leading-snug text-gray-900"><?= $escaper->escapeHtml(__('Yes — it\'s still sealed')) ?></span>
